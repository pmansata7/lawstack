# Lawstack environment variables
#
# Prisma CLI (`npx prisma db push`, migrations) reads `.env` in the project root.
# Next.js also loads `.env.local` at dev/build time. Easiest setup: copy this file
# to BOTH `.env` and `.env.local`, or keep DB vars in `.env` only.
#
# cp .env.example .env
# cp .env.example .env.local

# ─── Supabase (Auth + Storage) ─────────────────────────────────────
# Project Settings → API (NOT the database URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of your deployed app (email confirmation + OAuth redirects)
# Supabase Auth → URL Configuration → Site URL should match this value.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Postgres (Prisma) ─────────────────────────────────────────────
# Project Settings → Database → Connection string → URI
# Use the *database* password (Settings → Database), not the anon/service key.
#
# If the password contains @ # : / ? & = or spaces, URL-encode it, e.g. p@ss → p%40ss
#
# Use the Transaction pooler for DATABASE_URL (runtime). Use direct (5432) or Session
# pooler for DIRECT_URL — required for `prisma db push` / migrations (see schema directUrl).
#
# Pooled connection (Transaction mode, port 6543) — used by the app at runtime
# REQUIRED: pgbouncer=true (Prisma disables prepared statements; omitting it causes 42P05 errors)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Direct connection (port 5432) — Prisma migrations / db push
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# Legacy host format (still valid on many projects):
# DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
# DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# ─── AI (optional for local dev) ───────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=
# Optional server fallback for Granola import (org keys in Settings → AI are preferred)
# GRANOLA_API_KEY=
# ANTHROPIC_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AI_MODEL=
