# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Postgres (Settings → Database → Connection string)
# Use the "Transaction" pooler URL for DATABASE_URL and "Session" or direct for DIRECT_URL (Prisma migrations).
DATABASE_URL=
DIRECT_URL=

# AI (optional — defaults to OpenAI)
AI_PROVIDER=openai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AI_MODEL=
